{
  "name": "@fegih/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --lan",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "expo export --platform web --output-dir dist --clear && node scripts/patch-web-html.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "expo": "57.0.28",
    "expo-constants": "57.0.21",
    "expo-device": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "57.0.12",
    "expo-localization": "~57.0.2",
    "expo-location": "57.0.21",
    "expo-notifications": "57.0.22",
    "expo-router": "57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "i18next": "^25.5.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^16.0.1",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-constants",
        "expo-linking",
        "expo-location",
        "expo-notifications",
        "expo-router"
      ]
    }
  }
}
